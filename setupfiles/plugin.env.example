export LDAP_BASE_DN="dc=my,dc=example,dc=org"
export LDAP_BIND_USER_DN="cn=admin"
export LDAP_BIND_USER_PASSWORD=password
export LDAP_HOST="my.example.org"
export LDAP_PORT=3890
export NOTED_APP_PORT=8080
export SECRET_KEY='dev'
export LDAP_USERNAME="$LDAP_BIND_USER_DN,ou=services,$LDAP_BASE_DN"
export LDAP_PASSWORD="$LDAP_BIND_USER_PASSWORD"
