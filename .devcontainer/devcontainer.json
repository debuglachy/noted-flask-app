{
  "name": "Python 3",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install -r requirements.txt && .venv/bin/pip install pytest coverage pytest-cov",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "github.vscode-github-actions"
      ]
    }
  }
}